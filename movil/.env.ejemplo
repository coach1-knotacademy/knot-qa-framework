# MODELO de las variables del kit móvil. Este archivo SÍ se sube y no tiene valores.
#
# Lo normal: no hace falta nada. Sin variables se usa Appium en 127.0.0.1:4723, el primer
# emulador que vea adb y la app en apps/mda-2.3.0-27.apk.
#
# Para cambiar algo solo en esta terminal (PowerShell):
#   $env:DISPOSITIVO = 'emulator-5556'
#   npm.cmd test
#
# Si prefieres un archivo: copia este como .env (en esta misma carpeta movil/), quita el # y llena
# SOLO lo que necesites. El .env está en .gitignore. Lo que escribas en la terminal manda sobre el .env.

# Dónde escucha el servidor de Appium.
# APPIUM_HOST=127.0.0.1
# APPIUM_PUERTO=4723

# El nombre que muestra "adb devices" (emulator-5554, o el serial de un celular por USB).
# DISPOSITIVO=emulator-5554

# Versión de Android del dispositivo (opcional; si la pones y no coincide, Appium no arranca).
# VERSION_ANDROID=

# Ruta del APK. Relativa a movil/ o absoluta.
# RUTA_APP=apps/mda-2.3.0-27.apk

# Más tiempo para el primer arranque en equipos lentos (milisegundos).
# TIEMPO_ARRANQUE=120000

# Pausa después de cada paso (ms), solo para grabar una demo que se pueda seguir. 0 = normal.
# PASO_LENTO=1200
