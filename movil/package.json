{
  "name": "knot-qa-movil",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Kit móvil del Bootcamp QA: Appium + WebdriverIO + TypeScript sobre una app pública de práctica (SauceLabs My Demo App, Android). Mismas capas que el framework de Playwright: config, páginas, datos y pruebas.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "app": "node scripts/descargar-app.js",
    "appium": "appium --address 127.0.0.1 --port 4723",
    "doctor": "appium driver doctor uiautomator2",
    "test": "wdio run ./wdio.conf.ts",
    "tipos": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@wdio/cli": "9.29.1",
    "@wdio/globals": "9.29.1",
    "@wdio/local-runner": "9.29.1",
    "@wdio/mocha-framework": "9.29.1",
    "@wdio/spec-reporter": "9.29.1",
    "typescript": "5.9.3",
    "webdriverio": "9.29.1"
  }
}
